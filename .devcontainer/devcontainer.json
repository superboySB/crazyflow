{
  "name": "Crazyflow dani",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspace/crazyflow",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/crazyflow,type=bind",
  "containerEnv": {
    "PYTHONPATH": "/workspace/crazyflow"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests"
        ]
      }
    }
  },
  "remoteUser": "root",
  "runArgs": [
    "--init"
  ]
}
