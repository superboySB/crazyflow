#!/usr/bin/env bash
set -euo pipefail
project_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
command_name=${1:-help}
if [[ $# -gt 0 ]]; then shift; fi
case "$command_name" in
  setup|train|identify|evaluate|play)
    exec "$project_dir/scripts/$command_name.sh" "$@"
    ;;
  capacity) exec python3 "$project_dir/scripts/capacity.py" "$@" ;;
  sim2sim) exec python3 "$project_dir/sim2sim/run.py" "$@" ;;
  help|-h|--help)
    cat <<'HELP'
用法：./crazyrl <步骤> [选项]
  setup       构建 Docker，检测 GPU；不可用时自动选择 CPU
  identify    建立测量模板、拟合推力/电机参数或检查辨识工具
  train       训练 JAX PPO ToF 避障策略，自动创建结果目录
  evaluate    用 Crazyflow 评测最近一次正式模型
  play        实时 MuJoCo 避障与 ToF 面板，支持 reset（--headless 导出轨迹）

  capacity    实测多环境 PPO 吞吐与显存（GPU）
  sim2sim     独立 Isaac 镜像评测/播放 baseline 和新模型

每步可加 --help 查看选项。无需激活 Python 或保留终端变量。
HELP
    ;;
  *) printf '未知步骤：%s。请运行 ./crazyrl --help。\n' "$command_name" >&2; exit 2 ;;
esac
