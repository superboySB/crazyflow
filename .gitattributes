*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.pdf binary
*.stl binary
*.npz binary
*.png binary
# Preserve whitespace in the byte-identical upstream README.
docs/crazyflow_experiments_sysid/README.md whitespace=-blank-at-eol

# Python's CSV writer uses standard CRLF record endings.
*.csv whitespace=cr-at-eol

# Preserve the frozen upstream files byte-for-byte for provenance verification.
sim2sim/reference/** -text -whitespace
models/baseline/*.yaml -text -whitespace
